{
  "name": "cadence",
  "productName": "Cadence",
  "version": "0.3.0",
  "description": "Local-first automatic time tracker for macOS. No account, no server.",
  "license": "MIT",
  "author": "Sujal Shrestha",
  "homepage": "https://suzalshrestha.github.io/cadence/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuzalShrestha/cadence.git"
  },
  "bugs": {
    "url": "https://github.com/SuzalShrestha/cadence/issues"
  },
  "keywords": [
    "time-tracker",
    "productivity",
    "electron",
    "macos",
    "local-first",
    "focus",
    "pomodoro"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "lint": "biome lint --error-on-warnings .",
    "check": "npm run lint && npm test",
    "smoke": "CADENCE_DATA=\"$(mktemp -d)\" CADENCE_SMOKE=\"${SMOKE_DIR:-$(mktemp -d)}\" electron .",
    "dist": "electron-builder --mac --publish never",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  },
  "build": {
    "appId": "io.github.suzalshrestha.cadence",
    "productName": "Cadence",
    "copyright": "Copyright © 2026 Cadence contributors",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Cadence reads the frontmost app, its window title and the current browser tab to track your time. This data stays on your Mac."
      },
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "title": "Cadence ${version}",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "afterPack": "scripts/sign-mac.js",
    "publish": [
      {
        "provider": "github",
        "owner": "SuzalShrestha",
        "repo": "cadence",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,css,json}": "biome lint --error-on-warnings --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=22"
  }
}
