{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!!**/dist", "!!docs", "!!src/ui/icons.js", "!!.claude"] },
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "useTemplate": "off" },
			"suspicious": { "useIterableCallbackReturn": "off" },
			"complexity": { "noImportantStyles": "off" }
		}
	},
	"css": { "linter": { "enabled": true } },
	"overrides": [{ "includes": ["**/*.css"], "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } } }],
	"assist": { "enabled": false }
}
